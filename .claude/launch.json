{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run", "--python", "3.12", "--no-project",
        "--with", "sqlalchemy", "--with", "fastapi", "--with", "uvicorn[standard]", "--with", "websockets",
        "python", "-m", "uvicorn", "services.api.main:app", "--host", "127.0.0.1", "--port", "8000"
      ],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "web",
      "port": 5173
    }
  ]
}
