# ---------------------------------------------------------------------------
# khalij-watch configuration. Copy to .env and fill in.
# .env is gitignored and must never be committed.
# ---------------------------------------------------------------------------

# --- Copernicus Data Space Ecosystem (REQUIRED) ----------------------------
# Free account: https://dataspace.copernicus.eu/
# This is the project's backbone: Sentinel-1 SAR imagery.
#
# THERE ARE THREE DIFFERENT CREDENTIALS AND THEY DO DIFFERENT THINGS.
#
# 1. Nothing at all -> catalogue search works. Scene discovery and the
#    coverage overlay need no credentials whatsoever.
#
# 2. S3 keys -> READING PIXELS. This is the one that matters. Generate them
#    in the CDSE dashboard, and note they are NOT the same as an OAuth
#    client. Only this path supports the byte-range windowed reads the
#    project depends on; without it a whole 1 GB scene must be downloaded.
CDSE_S3_ACCESS_KEY=
CDSE_S3_SECRET_KEY=
CDSE_S3_ENDPOINT=https://eodata.dataspace.copernicus.eu

# 3. An OAuth client (id starts "sh-") or an account login. Useful for
#    authenticated metadata, but a Sentinel Hub OAuth client is REFUSED by
#    the download service with "Token audience not allowed" - it cannot read
#    product data. Set either pair; the grant type is detected automatically.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
CDSE_USERNAME=
CDSE_PASSWORD=

# --- AIS (REQUIRED for Phase 1) --------------------------------------------
# Free key: https://aisstream.io/authenticate
# NOTE: aisstream publishes no terms of service or data licence. Fine for
# academic use; get written clarification before any commercial use.
AISSTREAM_API_KEY=
AISSTREAM_WS_URL=wss://stream.aisstream.io/v0/stream

# Fallback AIS, same protocol shape. Re-serves per-source licences, so the
# `source` field MUST be propagated through to the UI for attribution.
AISCAST_WS_URL=wss://ais.openwaters.io/v0/stream
AISCAST_TOKEN=

# --- Optional enrichment (keep behind an interface: all non-commercial) ----
# https://globalfishingwatch.org/our-apis/  (CC BY-NC 4.0)
GFW_API_TOKEN=

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://khalij:khalij@localhost:5432/khalij

# --- Area of interest ------------------------------------------------------
# Full Persian Gulf, used by the platform.
AOI_GULF_BBOX=47.5,23.5,58.0,30.5
# Strait of Hormuz, used for DL training and evaluation (~2.0 day revisit).
AOI_HORMUZ_BBOX=54.0,24.5,57.5,27.5

# --- Storage (never C: — it is nearly full) --------------------------------
DATA_DIR=E:/sea-vessel-detection-3/data
MODELS_DIR=E:/sea-vessel-detection-3/models
